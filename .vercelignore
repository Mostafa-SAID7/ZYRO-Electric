# Vercel Build Ignore File
# Files and directories to exclude from Vercel deployments

# Version control
.git
.gitignore
.gitattributes

# Node
node_modules
npm-debug.log
yarn-error.log
.npm
pnpm-lock.yaml

# Build outputs (will be regenerated)
dist
build
.angular

# Development
.vscode
.idea
.DS_Store
*.swp
*.swo
*~
.env
.env.local
.env.*.local

# Documentation
*.md
docs
README.md
CHANGELOG.md

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Testing
coverage
.nyc_output
karma.conf.js
test

# CI/CD
.github
.gitlab-ci.yml
.travis.yml
Jenkinsfile

# Analytics
.vercelignore

# Temporary files
*.tmp
*.temp
*.bak
.cache
