{
  "name": "ZYRO Electric",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/market",
  "framework": "angular",
  "nodeVersion": "22.x",
  "env": {
    "NODE_ENV": "production",
    "CI": "true"
  },
  "regions": ["iad1"],
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "github": {
    "enabled": true,
    "silent": false,
    "autoAlias": true,
    "autoJobCancelPreviousOnPush": true
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
